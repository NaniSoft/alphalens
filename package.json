{
  "name": "@nanisoft/alphalens",
  "version": "0.0.0",
  "private": true,
  "description": "alphalens.nanisoft.com — AlphaLens: quantitative trading research for the Indian (NSE/BSE) market. Landing, full docs, and blog.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:routes": "node scripts/check-routes.mjs",
    "check:both-modes": "node scripts/check-both-modes.mjs",
    "check:prism-gates": "prism-gates",
    "check": "pnpm check:prism-gates && pnpm check:routes && pnpm ui:check",
    "check:local": "pnpm check && pnpm check:both-modes",
    "ui:check": "node scripts/check-ui-compliance.mjs",
    "ui:check:fixtures": "node scripts/check-ui-compliance.mjs --fixtures",
    "ui:test": "pnpm ui:check && pnpm ui:check:fixtures && pnpm test",
    "ui:runtime": "playwright test",
    "ui:check:full": "pnpm ui:check && pnpm ui:check:fixtures && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check && pnpm ui:runtime"
  },
  "dependencies": {
    "@nanisoft/prism-ui": "1.8.0",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "serve": "^14.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1",
    "wrangler": "^4.135.0"
  }
}
